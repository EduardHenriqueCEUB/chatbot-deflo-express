# Copie este arquivo com o nome .env e preencha
# NUNCA envie o arquivo .env original para ninguém nem para o GitHub

# --- Alerta no celular do atendente (Telegram) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEGREDO=

# --- WhatsApp Cloud API (painel developers.facebook.com) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Senha inventada por você; digite a mesma no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v25.0

# --- Google Drive (pasta "Chatbot Deflo - Dados") ---
# ID da pasta: é o código no fim do endereço da pasta no navegador (depois de /folders/)
DRIVE_PASTA_ID=

# Caminho COMPLETO do arquivo .json da chave da conta robô (fora da pasta do projeto)
# Ex.: C:\Users\SEU_USUARIO\Documents\Chaves Deflo\chatbot-deflo-xxxxxxxx.json
GOOGLE_CREDENCIAIS_ARQUIVO=

# --- Aviso de e-mail novo no Telegram ---
EMAIL_ENDERECO=
EMAIL_SENHA_APP=COLE_AQUI_A_SENHA_DE_APP